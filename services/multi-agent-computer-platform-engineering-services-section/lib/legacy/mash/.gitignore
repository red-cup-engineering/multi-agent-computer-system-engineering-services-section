/target
/.substrate
/.mash
/.claude

# Nix build outputs — `nix build` drops a `result` symlink; `result-*`
# for named outputs.
/result
/result-*

# Cargo lock is checked in at the root; per-workspace dirs get their build artifacts from the root target/.
/.agentics

# insta pending-review snapshots — the committed `.snap` files are
# the source of truth; `.snap.new` is generated by a failed run.
**/*.snap.new
