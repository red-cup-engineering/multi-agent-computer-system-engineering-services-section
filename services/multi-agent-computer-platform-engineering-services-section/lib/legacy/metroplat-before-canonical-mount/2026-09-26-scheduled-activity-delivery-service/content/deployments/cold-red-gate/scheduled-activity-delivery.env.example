# Copy to ~/.config/emsenn/scheduled-activity-delivery.env on Cold Red Gate and
# replace each explicit local path. This file carries no credential, schedule,
# or signing material. Supply exactly one selector: the legacy JOB manifest or
# the QUEUE directory (recommended). The Koios routine bin validates the queue,
# manifest, and public-key-map content; this carrier only exposes fixed,
# non-ambient paths.
# The output and replay roots are the only host paths mounted read-write inside
# the Bubblewrap target; all other host content, including the target package,
# is mounted read-only.
# KOIOS_NEWS_ROUTINE_PUBLICATION_JOB=/home/REPLACE_WITH_VPS_ACCOUNT/.local/share/emsenn/koios-news/routine-job.json
KOIOS_NEWS_ROUTINE_PUBLICATION_QUEUE=/home/REPLACE_WITH_VPS_ACCOUNT/.local/share/emsenn/koios-news/routine-job-queue
KOIOS_NEWS_ROUTINE_PUBLICATION_AUTHORITY_KEYS=/home/REPLACE_WITH_VPS_ACCOUNT/.local/share/emsenn/koios-news/editorial-publication-keys.json
KOIOS_NEWS_ROUTINE_PUBLICATION_ASSESSMENT_KEYS=/home/REPLACE_WITH_VPS_ACCOUNT/.local/share/emsenn/koios-news/editorial-assessment-keys.json
KOIOS_NEWS_ROUTINE_PUBLICATION_BASELINE_ROOT=/home/REPLACE_WITH_VPS_ACCOUNT/.local/share/emsenn/koios-news/baselines/koios-continuity-baseline
KOIOS_NEWS_ROUTINE_PUBLICATION_OUTPUT_ROOT=/home/REPLACE_WITH_VPS_ACCOUNT/.local/share/emsenn/koios-news/candidates
KOIOS_NEWS_ROUTINE_PUBLICATION_REPLAY_ROOT=/home/REPLACE_WITH_VPS_ACCOUNT/.local/share/emsenn/koios-news/replays
