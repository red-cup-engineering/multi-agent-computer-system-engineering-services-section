[Unit]
Description=Cold Red Gate ScheduleDelivery contracted delivery tick
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/services/scheduled-activity-delivery-service
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=SCHEDULED_ACTIVITY_DELIVERY_ACTOR=https://bare-cedar-fog.561.group/actors/cold-red-gate-scheduled-activity-delivery
Environment=SCHEDULED_ACTIVITY_DELIVERY_ROOT=%h/services/scheduled-activity-delivery-service
Environment=WITNESS_JOURNAL_RDF_AGENT=http://127.0.0.1:8787/.well-known/agent-card.json
EnvironmentFile=%h/.config/emsenn/scheduled-activity-delivery.env
Environment=SCHEDULED_ACTIVITY_DELIVERY_TARGET_ENV_ALLOWLIST=KOIOS_NEWS_ROUTINE_PUBLICATION_JOB,KOIOS_NEWS_ROUTINE_PUBLICATION_QUEUE,KOIOS_NEWS_ROUTINE_PUBLICATION_AUTHORITY_KEYS,KOIOS_NEWS_ROUTINE_PUBLICATION_ASSESSMENT_KEYS,KOIOS_NEWS_ROUTINE_PUBLICATION_BASELINE_ROOT,KOIOS_NEWS_ROUTINE_PUBLICATION_OUTPUT_ROOT,KOIOS_NEWS_ROUTINE_PUBLICATION_REPLAY_ROOT
Environment=SCHEDULED_ACTIVITY_DELIVERY_TARGET_WRITABLE_ROOT_ENV_ALLOWLIST=KOIOS_NEWS_ROUTINE_PUBLICATION_OUTPUT_ROOT,KOIOS_NEWS_ROUTINE_PUBLICATION_REPLAY_ROOT
# The target receives one local job manifest or queue, public key maps, and fixed
# read-only baseline and candidate/replay roots. Bubblewrap exposes the latter
# two as its only writable mounts; ScheduleDelivery never grants ambient
# configuration, credentials, or a caller-selected command/path to the target.
TimeoutStartSec=65min
Nice=10
CPUWeight=50
IOWeight=50
MemoryHigh=20%
MemoryMax=30%
MemorySwapMax=0
TasksMax=64
OOMPolicy=stop
ExecStart=/gnu/store/kba00zrnc1d1cg9bkx0krpvc2sp7wzrh-node-24.18.0/bin/node src/service.mjs --operation run-due
