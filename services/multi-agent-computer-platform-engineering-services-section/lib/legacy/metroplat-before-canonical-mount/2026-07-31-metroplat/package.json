  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.lib.json && tsc -p tsconfig.src.json && node scripts/copy-dist-assets.mjs && chmod +x dist/src/scripts/infograph.mjs dist/src/scripts/infograph-serve.mjs dist/src/scripts/infograph-mcp.mjs dist/src/scripts/infograph-lsp.mjs dist/src/scripts/infograph-federation.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check-package": "npm_config_cache=.tmp/npm-cache npm pack --dry-run --ignore-scripts --loglevel=error",
    "verify": "npm run check && npm run build && npm run test && npm run check-package",
    "docs:api": "typedoc",
    "prepack": "npm run verify",
    "rebuild": "npm run clean && npm run build"
  },
