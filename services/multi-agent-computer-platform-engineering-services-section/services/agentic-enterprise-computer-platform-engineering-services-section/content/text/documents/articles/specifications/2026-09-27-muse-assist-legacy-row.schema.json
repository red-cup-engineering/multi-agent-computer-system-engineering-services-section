{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legacy SEAVT row custody artifact",
  "type": "object",
  "properties": {
    "kind": {
      "const": "metroplat.journal.legacy-seavt-row"
    },
    "version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "line": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "length": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "raw": {
      "type": "string"
    },
    "row": {
      "type": "object",
      "properties": {
        "e": {
          "type": "array"
        },
        "a": {
          "type": "array"
        },
        "v": {
          "type": "array"
        },
        "t": {}
      },
      "required": [
        "e",
        "a",
        "v",
        "t"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "kind",
    "version",
    "source",
    "line",
    "offset",
    "length",
    "raw",
    "row"
  ],
  "additionalProperties": false
}
