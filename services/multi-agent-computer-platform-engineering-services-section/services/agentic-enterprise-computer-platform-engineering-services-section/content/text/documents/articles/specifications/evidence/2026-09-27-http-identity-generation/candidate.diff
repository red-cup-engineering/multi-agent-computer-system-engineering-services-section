+/** Resolve one closed HTTP identity decision without exposing malformed input. */
+export function resolveHttpRequestIdentity(headers, config) {
+  try {
+    if (config?.gatewayToken !== undefined) {
+      const configuredToken = config.gatewayToken;
+      if (typeof configuredToken !== "string" || configuredToken.length === 0) {
+        return Object.freeze({ kind: "refused" });
+      }
+      const token = singleHeaderValue(headers, ASSERTED_GATEWAY_TOKEN_HEADER);
+      const subject = singleHeaderValue(headers, ASSERTED_SUBJECT_HEADER);
+      if (token === undefined || subject === undefined || subject.length === 0
+        || subject.length > ASSERTED_SUBJECT_MAX_LENGTH
+        || !ASSERTED_SUBJECT_PATTERN.test(subject)
+        || !timingSafeStringEqual(token, configuredToken)) {
+        return Object.freeze({ kind: "refused" });
+      }
+      return Object.freeze({ kind: "gateway", subject });
+    }
+    if (headers[ASSERTED_SUBJECT_HEADER] !== undefined
+      || headers[ASSERTED_GATEWAY_TOKEN_HEADER] !== undefined) {
+      return Object.freeze({ kind: "refused" });
+    }
+    return Object.freeze({ kind: "process" });
+  } catch {
+    return Object.freeze({ kind: "refused" });
+  }
+}
