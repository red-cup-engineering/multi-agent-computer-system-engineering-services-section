/** Journal-backed implementation of witnessed encounter admission and section reading. */
import { artifactId } from "@red-cup-engineering/computer-code-engineering-services-section/semiotic-eavt/identity";
import { isJsonRecord, parse, requireJsonValue } from "@red-cup-engineering/json-services-section";
import { followJournalSection, readJournalSection } from "@red-cup-engineering/computer-system-engine/journal/section";
import { journal, openJournal } from "@red-cup-engineering/computer-system-engine/journal/journal";
import {
  isEncounterContribution,

} from "@red-cup-engineering/feltos/encounter/model";
import { eavtRecord, toEavt } from "@red-cup-engineering/eavt-services-section/row";

const ENCOUNTER_RUN_LOCATOR_AT = "0000-00-00";
const ENCOUNTER_RUN_LOCATOR_NAMESPACE = "encounter-run";

function feedFor(root, run, namespace) {
  const locator = openJournal(root).readHead(ENCOUNTER_RUN_LOCATOR_AT, ENCOUNTER_RUN_LOCATOR_NAMESPACE, run.id);
  const openedAt = typeof locator?.openedAt === "string" ? locator.openedAt : run.openedAt;
  return journal.feed(root, "encounter", openedAt, {
    rootName: namespace,
    subject: `encounter-${run.id}`,
  });
}

function evidenceFromEvent(event) {
  if (!Array.isArray(event.observation.payload)) return undefined;
  let row;
  try {
    row = eavtRecord(event.observation.payload);
  } catch {
    return undefined;
  }
  const value = row.v;
  if (!isJsonRecord(value) || typeof value.kind !== "string") return undefined;
  if (value.kind === "metroplat.encounter.opened") {
    if (!isJsonRecord(value.run)
      || value.run.kind !== "metroplat.encounter.run"
      || typeof value.run.id !== "string"
      || typeof value.at !== "string") return undefined;
    return value;
  }
  if (value.kind === "metroplat.encounter.contribution") {
    if (typeof value.run !== "string"
      || typeof value.at !== "string"
      || !isEncounterContribution(value.contribution)
      || value.contribution.run !== value.run) return undefined;
    return value;
  }
  return undefined;
}

function admissionOf(event) {
  const evidence = evidenceFromEvent(event);
  if (evidence === undefined) return undefined;
  const run = evidence.kind === "metroplat.encounter.opened" ? evidence.run.id : evidence.run;
  const material = requireJsonValue(evidence, "encounter evidence");
  const eventIds = Object.freeze([event.id]);
  return Object.freeze({
    kind: "metroplat.encounter.admission",
    id: artifactId(Object.freeze({ material, eventIds })),
    evidence: evidence.kind,
    run,
    eventIds,
    material,
  });
}

function sectionAdmissions(feed) {
  return Object.freeze(readJournalSection(feed.artifact).events.flatMap((event) => {
    const admission = admissionOf(event);
    return admission === undefined ? [] : [admission];
  }));
}

function canonicalEventIndex(feed) {
  const index = new Map();
  for (const event of readJournalSection(feed.artifact).events) {
    const evidence = evidenceFromEvent(event);
    const canonical = evidence?.kind === "metroplat.encounter.opened"
      ? evidence.run.id
      : evidence?.contribution.id;
    if (canonical === undefined) continue;
    const events = index.get(canonical);
    if (events === undefined) index.set(canonical, [event.id]);
    else events.push(event.id);
  }
  return index;
}

function canonicalEvidenceId(evidence) {
  return evidence.kind === "metroplat.encounter.opened" ? evidence.run.id : evidence.contribution.id;
}

function existingAdmission(feed, evidence) {
  const canonical = canonicalEvidenceId(evidence);
  return sectionAdmissions(feed).find((admission) => {
    const material = admission.material;
    return canonicalEvidenceId(material) === canonical;
  });
}

function witnessedCauseRefs(root, references) {
  return Object.freeze(references.filter((reference) => {
    try {
      const artifact = journal.readArtifact(root, reference);
      if (artifact === undefined) return false;
      const value = parse(artifact.canonicalText);
      return isJsonRecord(value) && value.kind === "metroplat.witness-core";
    } catch {
      return false;
    }
  }).sort());
}

function evidenceCauses(root, feed, evidence) {
  if (evidence.kind === "metroplat.encounter.opened") return Object.freeze([]);
  const externalWitnesses = witnessedCauseRefs(root, evidence.contribution.causes);
  const predecessors = evidence.contribution.predecessors;
  if (predecessors.length === 0) return Object.freeze([...new Set([
    ...readJournalSection(feed.artifact).frontier,
    ...externalWitnesses,
  ])].sort());
  const index = canonicalEventIndex(feed);
  const unresolved = predecessors.filter((predecessor) => !index.has(predecessor));
  if (unresolved.length > 0) {
    throw new TypeError(`encounter contribution has unadmitted predecessors: ${unresolved.join(", ")}`);
  }
  return Object.freeze([...new Set([
    ...predecessors.flatMap((predecessor) => index.get(predecessor) ?? []),
    ...externalWitnesses,
  ])].sort());
}

function validateEvidence(run, evidence) {
  if (evidence.kind === "metroplat.encounter.opened") {
    if (evidence.run.id !== run.id) throw new TypeError("encounter opening names a different run");
    return;
  }
  if (evidence.run !== run.id || evidence.contribution.run !== run.id) {
    throw new TypeError("encounter contribution names a different run");
  }
}

/**
 * Build one encounter store whose writes and reads meet at the journal.
 *
 * Each run is anchored to its opening date and receives its own feed, so it
 * remains directly addressable across process restarts and across midnight.
 */
export function journalEncounterStore(root, options = {}) {
  const store = openJournal(root);
  const namespace = options.namespace ?? "@red-cup-engineering/metroplat";
  return Object.freeze({
    causalHead(run) {
      return readJournalSection(feedFor(root, run, namespace).artifact).frontier;
    },

    admit(run, evidence) {
      validateEvidence(run, evidence);
      const feed = feedFor(root, run, namespace);
      const existing = existingAdmission(feed, evidence);
      if (existing !== undefined) return existing;
      const material = requireJsonValue(evidence, "encounter evidence");
      const causes = Object.freeze([...new Set([
        ...evidenceCauses(root, feed, evidence),
        ...(options.causes?.(run, evidence) ?? []),
      ])].sort());
      const admission = store.appendRows("encounter", [toEavt({
        e: run.id,
        a: Object.freeze({ kind: evidence.kind }),
        v: material,
        t: evidence.at,
      })], {
        at: run.openedAt,
        rootName: namespace,
        subject: `encounter-${run.id}`,
        caller: Object.freeze({ kind: "metroplat.encounter.witness", evidence: evidence.kind }),
        eventCauses: causes,
      });
      const eventIds = Object.freeze((admission.statements ?? []).map((statement) => statement.id));
      if (evidence.kind === "metroplat.encounter.opened" && eventIds.length > 0) {
        store.writeHead(ENCOUNTER_RUN_LOCATOR_AT, ENCOUNTER_RUN_LOCATOR_NAMESPACE, run.id, Object.freeze({
          kind: "metroplat.encounter.run-locator",
          run: run.id,
          openedAt: run.openedAt,
        }));
      }
      return Object.freeze({
        kind: "metroplat.encounter.admission",
        id: artifactId(Object.freeze({ material, eventIds })),
        evidence: evidence.kind,
        run: run.id,
        eventIds,
        material,
      });
    },

    read(run) {
      return sectionAdmissions(feedFor(root, run, namespace));
    },

    follow(run, followOptions = {}) {
      const feed = feedFor(root, run, namespace);
      const interval = followOptions.pollIntervalMs ?? options.pollIntervalMs;
      return Object.freeze({
        async *[Symbol.asyncIterator]() {
          for await (const event of followJournalSection(feed.artifact, {
            ...(followOptions.after === undefined ? {} : { after: followOptions.after }),
            ...(followOptions.signal === undefined ? {} : { signal: followOptions.signal }),
            ...(interval === undefined ? {} : { pollIntervalMs: interval }),
          })) {
            const admission = admissionOf(event);
            if (admission !== undefined && admission.run === run.id) yield admission;
          }
        },
      });
    },
  });
}
