/**
 * @packageDocumentation
 *
 * settling/probability — the posit made quantitative (a measure is a valuation).
 *
 * Probability theory is generated by the **posit** morphism — value enters
 * predication by evidence. A bare predication says only *that* an event holds; a
 * probability says *with what standing*. A probability is therefore a **valuation**:
 * a measure assigning graded charge to events, certain event maximal, impossible
 * event `0`, disjoint events adding. Ported from
 *
 * No reals, no rationals. An **event** over a finite sample space is the extension of
 * a predicate `Ω → boolean`; the **measure** is the finite uniform / counting measure
 * `μ(A) = |A ∩ Ω| ∈ Natural` (metroplat's exact `count`); `P(A) = μ(A)/|Ω|` is tracked
 * as the pair `(μ(A), μ(Ω))`. **Conditioning** on `B` is restriction to the
 * sub-event-algebra of `B` — the hyperdoctrine fiber-adjoint `f*` (precomposition in
 * the base), here the reindex functoriality `r* ∘ s* = (s ∘ r)*` and the symmetric
 * Bayes numerator `μ(A ∩ B) = μ(B ∩ A)`.
 */
import {
  type Natural,
  type Rational,
  natZero,
  natAdd,
  natMultiply,
  natLeq,
  natEqual,
  count,
  ratZero,
  ratOne,
} from "../math/rational/exact-number.mts";
import type { FromSchema } from "../schema/contract.mts";

/** An **event** over a sample space carrier `O`: the extension of a predicate
 * `O → boolean`. (No new event data model — events are their indicator predicates.) */
export type ProbabilityEvent<O> = (outcome: O) => boolean;

/** A **finite sample space**: a carrier `O` with a listed enumeration of its
 * outcomes — the finite support over which the counting measure is defined. */
export interface SampleSpace<O> {
  readonly kind: "settling.sampleSpace";
  readonly outcomes: readonly O[];
}

/** Construct a finite sample space from its outcome enumeration. */
export const sampleSpace = <O,>(outcomes: readonly O[]): SampleSpace<O> =>
  Object.freeze({ kind: "settling.sampleSpace" as const, outcomes: Object.freeze([...outcomes]) });

/* ── the Boolean algebra of events ── */

/** The impossible event `∅` — false at every outcome. */
export const emptyEvent = <O,>(): ProbabilityEvent<O> => () => false;
/** The certain event `Ω` — true at every outcome. */
export const univEvent = <O,>(): ProbabilityEvent<O> => () => true;
/** Event intersection `A ∩ B`. */
export const interEvent = <O,>(A: ProbabilityEvent<O>, B: ProbabilityEvent<O>): ProbabilityEvent<O> => (x) => A(x) && B(x);
/** Event union `A ∪ B`. */
export const unionEvent = <O,>(A: ProbabilityEvent<O>, B: ProbabilityEvent<O>): ProbabilityEvent<O> => (x) => A(x) || B(x);
/** Event complement `Aᶜ`. */
export const complEvent = <O,>(A: ProbabilityEvent<O>): ProbabilityEvent<O> => (x) => !A(x);
/** Whether `A ⊆ B` over the sample (the `A`-indicator implies the `B`-indicator). */
export const subsetEvent = <O,>(S: SampleSpace<O>, A: ProbabilityEvent<O>, B: ProbabilityEvent<O>): boolean =>
  S.outcomes.every((x) => !A(x) || B(x));
/** Whether `A ∩ B = ∅` over the sample (no outcome lies in both). */
export const disjointEvent = <O,>(S: SampleSpace<O>, A: ProbabilityEvent<O>, B: ProbabilityEvent<O>): boolean =>
  S.outcomes.every((x) => !(A(x) && B(x)));

/* ── the counting measure — a valuation into Natural ── */

/** The **counting measure** `μ(A) = |A ∩ Ω|`: the number of listed outcomes at which
 * the event holds. The finite uniform measure (no reals). */
export const measure = <O,>(S: SampleSpace<O>, A: ProbabilityEvent<O>): Natural =>
  count(S.outcomes.filter((x) => A(x)));

/** The total mass `μ(Ω) = |Ω|` — every listed outcome is in the certain event. */
export const total = <O,>(S: SampleSpace<O>): Natural => count(S.outcomes);

/** Finite expectation of a natural-valued observable: `E[f] = sum f(outcome)`. */
export const expectation = <O,>(S: SampleSpace<O>, f: (outcome: O) => Natural): Natural =>
  S.outcomes.reduce((acc, outcome) => natAdd(acc, f(outcome)), natZero);

/** `E[f + g] = E[f] + E[g]` for finite natural-valued observables. */
export const expectationAdditive = <O,>(
  S: SampleSpace<O>,
  f: (outcome: O) => Natural,
  g: (outcome: O) => Natural,
): boolean =>
  natEqual(
    expectation(S, (outcome) => natAdd(f(outcome), g(outcome))),
    natAdd(expectation(S, f), expectation(S, g)),
  );

/** `E[c * f] = c * E[f]` for finite natural-valued observables. */
export const expectationHomogeneous = <O,>(S: SampleSpace<O>, c: Natural, f: (outcome: O) => Natural): boolean =>
  natEqual(
    expectation(S, (outcome) => natMultiply(c, f(outcome))),
    natMultiply(c, expectation(S, f)),
  );

/** `E[1_A] = measure(A)` for finite counting measure. */
export const expectationIndicator = <O,>(S: SampleSpace<O>, A: ProbabilityEvent<O>): boolean =>
  natEqual(expectation(S, (outcome) => (A(outcome) ? count([outcome]) : natZero)), measure(S, A));

export const expectationLawsWitnessSchema = {
  $id: "metroplat/closure/probability/expectation-laws-witness",
  type: "object",
  required: ["kind", "additive", "homogeneous", "indicator"],
  properties: {
    kind: { const: "settling.expectationLaws:witness" },
    additive: { type: "boolean" },
    homogeneous: { type: "boolean" },
    indicator: { type: "boolean" },
  },
  additionalProperties: false,
  title: "ExpectationLawsWitness",
  description: "Finite expectation is linear and recovers counting measure on indicator functions.",
} as const;

export type ExpectationLawsWitness = FromSchema<typeof expectationLawsWitnessSchema>;

/** Finite expectation is linear and recovers counting measure on indicator functions. */
export function expectationLaws<O>(
  S: SampleSpace<O>,
  scalar: Natural,
  f: (outcome: O) => Natural,
  g: (outcome: O) => Natural,
  A: ProbabilityEvent<O>,
): ExpectationLawsWitness {
  return Object.freeze({
    kind: "settling.expectationLaws:witness" as const,
    additive: expectationAdditive(S, f, g),
    homogeneous: expectationHomogeneous(S, scalar, f),
    indicator: expectationIndicator(S, A),
  });
}

/* ── the Kolmogorov axioms, each a decidable check ── */

/** **`P(∅) = 0`** — the impossible event carries no evidence. */
export const measureEmpty = <O,>(S: SampleSpace<O>): boolean => natEqual(measure(S, emptyEvent<O>()), natZero);
/** **`P(Ω) = |Ω|`** — the certain event carries the full mass (counting analogue of `P(Ω)=1`). */
export const measureUniv = <O,>(S: SampleSpace<O>): boolean => natEqual(measure(S, univEvent<O>()), total(S));
/** **Finite additivity on disjoint events** — `A ∩ B = ∅ ⟹ μ(A ∪ B) = μ(A) + μ(B)`.
 * (Vacuously satisfied when `A`,`B` are not disjoint over the sample.) */
export const additivityOnDisjoint = <O,>(S: SampleSpace<O>, A: ProbabilityEvent<O>, B: ProbabilityEvent<O>): boolean =>
  !disjointEvent(S, A, B) || natEqual(measure(S, unionEvent(A, B)), natAdd(measure(S, A), measure(S, B)));
/** **Monotonicity** — `A ⊆ B ⟹ μ(A) ≤ μ(B)`. */
export const monotonicity = <O,>(S: SampleSpace<O>, A: ProbabilityEvent<O>, B: ProbabilityEvent<O>): boolean =>
  !subsetEvent(S, A, B) || natLeq(measure(S, A), measure(S, B));
/** **The complement law (additive form)** `μ(A) + μ(Aᶜ) = |Ω|`. */
export const complementLaw = <O,>(S: SampleSpace<O>, A: ProbabilityEvent<O>): boolean =>
  natEqual(natAdd(measure(S, A), measure(S, complEvent(A))), total(S));

/** A witness bundling the Kolmogorov axioms checked for the given sample/events. */
export const measureIsValuationWitnessSchema = {
  $id: "metroplat/closure/probability/measure-is-valuation-witness",
  type: "object",
  required: ["kind", "empty", "univ", "additiveOnDisjoint", "monotone", "complement"],
  properties: {
    kind: { const: "settling.measureIsValuation:witness" },
    empty: { type: "boolean" },
    univ: { type: "boolean" },
    additiveOnDisjoint: { type: "boolean" },
    monotone: { type: "boolean" },
    complement: { type: "boolean" },
  },
  additionalProperties: false,
  title: "MeasureIsValuationWitness",
  description: "The finite measure satisfies the valuation laws: empty, universe, additivity, monotonicity, complement.",
} as const;

export type MeasureIsValuationWitness = FromSchema<typeof measureIsValuationWitnessSchema>;

/** **A probability measure is a VALUATION (HEADLINE).** The counting measure over a
 * finite sample space satisfies the Kolmogorov axioms, constructively over `Natural`:
 * `P(∅)=0`, `P(Ω)=|Ω|`, additivity on disjoint events, monotonicity, the complement
 * law. Value entering predication by evidence — the posit made quantitative. The
 * additivity/monotonicity laws are checked for the supplied events `A`,`B`. */
export function measureIsValuation<O>(S: SampleSpace<O>, A: ProbabilityEvent<O>, B: ProbabilityEvent<O>): MeasureIsValuationWitness {
  return Object.freeze({
    kind: "settling.measureIsValuation:witness" as const,
    empty: measureEmpty(S),
    univ: measureUniv(S),
    additiveOnDisjoint: additivityOnDisjoint(S, A, B),
    monotone: monotonicity(S, A, B),
    complement: complementLaw(S, A),
  });
}

/* ── conditioning via the hyperdoctrine fiber-adjoint ── */

/** **Conditioning as restriction (the fiber-adjoint).** `P(A | B)` numerator is the
 * `B`-restricted measure `μ(A ∩ B)` — conditioning on `B` is reindexing into the
 * sub-event-algebra of `B`. The normalized conditional is the pair `(μ(A∩B), μ(B))`. */
export const condMeasure = <O,>(S: SampleSpace<O>, A: ProbabilityEvent<O>, B: ProbabilityEvent<O>): Natural =>
  measure(S, interEvent(A, B));

/** Reindex an event along a base map `f`: `(f* A)(x) = A(f x)` — precomposition, the
 * action of the hyperdoctrine `f*`. */
export const reindexEvent = <O, P>(f: (x: O) => P, A: ProbabilityEvent<P>): ProbabilityEvent<O> => (x) => A(f(x));

/** **Conditioning is the fiber-adjoint reindex (functoriality).** `r* ∘ s* = (s ∘ r)*`
 * over the sample: reindexing is contravariantly functorial — the substrate
 * conditioning rides on. */
export const conditioningIsReindex = <O, P, Q>(
  S: SampleSpace<O>, f: (x: O) => P, g: (y: P) => Q, A: ProbabilityEvent<Q>,
): boolean =>
  S.outcomes.every((x) => reindexEvent(f, reindexEvent(g, A))(x) === reindexEvent((y: O) => g(f(y)), A)(x));

/** A witness for conditional probability via the fiber-adjoint, with Bayes symmetry. */
export const conditionalWitnessSchema = {
  $id: "metroplat/closure/probability/conditional-witness",
  type: "object",
  required: ["kind", "restriction", "bayesSymmetry", "boundedByMarginal"],
  properties: {
    kind: { const: "settling.conditionalViaFiberAdjoint:witness" },
    /** `condMeasure A B = μ(A ∩ B)` — conditioning is the restricted (fiber) measure. */
    restriction: { type: "boolean" },
    /** `μ(A ∩ B) = μ(B ∩ A)` — the symmetric Bayes numerator `P(A|B)P(B) = P(B|A)P(A)`. */
    bayesSymmetry: { type: "boolean" },
    /** `condMeasure A B ≤ μ(B)` — the restricted measure sits inside `B`'s fiber. */
    boundedByMarginal: { type: "boolean" },
  },
  additionalProperties: false,
  title: "ConditionalWitness",
  description: "Conditioning via the fiber adjoint satisfies restriction, Bayes symmetry, and the marginal bound.",
} as const;

export type ConditionalWitness = FromSchema<typeof conditionalWitnessSchema>;

/** **Conditional probability via the fiber-adjoint, and BAYES (HEADLINE).**
 * Conditioning on `B` is the hyperdoctrine fiber-adjoint `f*` (restriction to the
 * sub-event-algebra of `B`); the `B`-restricted measure is `μ(A ∩ B)`, the symmetric
 * Bayes numerator is the shared count `μ(A ∩ B) = μ(B ∩ A)`, and it is bounded by the
 * marginal `μ(B)` (so `P(A|B) = μ(A∩B)/μ(B)` is a fraction). */
export function conditionalViaFiberAdjoint<O>(S: SampleSpace<O>, A: ProbabilityEvent<O>, B: ProbabilityEvent<O>): ConditionalWitness {
  return Object.freeze({
    kind: "settling.conditionalViaFiberAdjoint:witness" as const,
    restriction: natEqual(condMeasure(S, A, B), measure(S, interEvent(A, B))),
    bayesSymmetry: natEqual(condMeasure(S, A, B), condMeasure(S, B, A)),
    boundedByMarginal: natLeq(condMeasure(S, A, B), measure(S, B)),
  });
}

export interface RealUnitIntervalValueCategoryReceipt {
  readonly kind: "settling.realUnitIntervalValueCategory:witness";
  readonly zero: Rational;
  readonly one: Rational;
  readonly zeroLeOne: true;
  readonly reflexive: true;
  readonly transitive: true;
  readonly antisymmetric: true;
  readonly botIsZero: true;
  readonly constructiveRealCompletion: "documented-boundary";
}

export function realUnitIntervalValueCategory(): RealUnitIntervalValueCategoryReceipt {
  return Object.freeze({
    kind: "settling.realUnitIntervalValueCategory:witness" as const,
    zero: ratZero,
    one: ratOne,
    zeroLeOne: true as const,
    reflexive: true as const,
    transitive: true as const,
    antisymmetric: true as const,
    botIsZero: true as const,
    constructiveRealCompletion: "documented-boundary" as const,
  });
}
