{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.561.group/webship/mobility-v1.schema.json",
  "title": "Webship mobility records v1",
  "oneOf": [
    { "$ref": "#/$defs/continuityCapsule" },
    { "$ref": "#/$defs/berthOffer" },
    { "$ref": "#/$defs/berthReceipt" },
    { "$ref": "#/$defs/passageGrant" }
  ],
  "$defs": {
    "ni": {
      "type": "string",
      "pattern": "^ni:///sha-256;[A-Za-z0-9_-]+$"
    },
    "continuityCapsule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "vessel", "state", "authorityRoots", "command", "causalHeads", "openObligations", "holdings"],
      "properties": {
        "kind": { "const": "webship.continuity-capsule" },
        "version": { "const": 1 },
        "vessel": { "$ref": "#/$defs/ni" },
        "state": { "$ref": "#/$defs/ni" },
        "authorityRoots": { "type": "array", "items": { "$ref": "#/$defs/ni" }, "uniqueItems": true },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["epoch", "holder", "grant"],
          "properties": {
            "epoch": { "type": "integer", "minimum": 0 },
            "holder": { "$ref": "#/$defs/ni" },
            "grant": { "$ref": "#/$defs/ni" }
          }
        },
        "causalHeads": { "type": "array", "items": { "$ref": "#/$defs/ni" }, "uniqueItems": true },
        "openObligations": { "type": "array", "items": { "$ref": "#/$defs/ni" }, "uniqueItems": true },
        "holdings": { "type": "array", "items": { "$ref": "#/$defs/ni" }, "uniqueItems": true },
        "previousBerthReceipt": { "$ref": "#/$defs/ni" }
      }
    },
    "berthOffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "locus", "port", "capabilities"],
      "properties": {
        "kind": { "const": "webship.berth.offer" },
        "version": { "const": 1 },
        "locus": { "type": "string", "minLength": 1 },
        "port": { "$ref": "#/$defs/ni" },
        "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "limits": { "type": "object" }
      }
    },
    "berthReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "vessel", "state", "locus", "localSubject", "port", "evidence"],
      "properties": {
        "kind": { "const": "webship.berth.receipt" },
        "version": { "const": 1 },
        "vessel": { "$ref": "#/$defs/ni" },
        "state": { "$ref": "#/$defs/ni" },
        "locus": { "type": "string", "minLength": 1 },
        "localSubject": { "type": "string", "minLength": 1 },
        "port": { "$ref": "#/$defs/ni" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/ni" }, "minItems": 1, "uniqueItems": true }
      }
    },
    "passageGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "version", "vessel", "fromEpoch", "toEpoch", "fromBerth", "toBerth", "preparedBy", "causes"],
      "properties": {
        "kind": { "const": "webship.passage.grant" },
        "version": { "const": 1 },
        "vessel": { "$ref": "#/$defs/ni" },
        "fromEpoch": { "type": "integer", "minimum": 0 },
        "toEpoch": { "type": "integer", "minimum": 1 },
        "fromBerth": { "$ref": "#/$defs/ni" },
        "toBerth": { "$ref": "#/$defs/ni" },
        "preparedBy": { "$ref": "#/$defs/ni" },
        "causes": { "type": "array", "items": { "$ref": "#/$defs/ni" }, "minItems": 1, "uniqueItems": true }
      }
    }
  }
}
