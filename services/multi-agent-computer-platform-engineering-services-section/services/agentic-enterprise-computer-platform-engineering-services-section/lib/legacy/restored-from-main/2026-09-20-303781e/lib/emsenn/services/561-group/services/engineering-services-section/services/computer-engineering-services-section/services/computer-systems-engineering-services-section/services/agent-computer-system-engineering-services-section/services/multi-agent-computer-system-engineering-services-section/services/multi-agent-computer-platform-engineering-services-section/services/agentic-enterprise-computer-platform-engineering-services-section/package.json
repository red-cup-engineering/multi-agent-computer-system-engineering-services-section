{
  "name": "@red-cup-engineering/agentic-enterprise-computer-platform-engineering-services-section",
  "version": "0.3.0",
  "type": "module",
  "description": "Groups platforms whose persistent operating environment is an agentic enterprise, and the claim-charge vocabulary its apps (MetroPlat, FeltOS) share instead of each carrying or borrowing their own copy.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    "./claim-charge": {
      "types": "./dist/lib/claim-charge.d.mts",
      "import": "./dist/lib/claim-charge.mjs"
    },
    "./valuation-fiber-algebra": {
      "types": "./dist/lib/valuation-fiber-algebra.d.mts",
      "import": "./dist/lib/valuation-fiber-algebra.mjs"
    },
    "./closure-operator-fiber": {
      "types": "./dist/lib/closure-operator-fiber.d.mts",
      "import": "./dist/lib/closure-operator-fiber.mjs"
    },
    "./crdt-cohomological-calm": {
      "types": "./dist/lib/crdt-cohomological-calm.d.mts",
      "import": "./dist/lib/crdt-cohomological-calm.mjs"
    }
  },
  "files": [
    "dist/lib",
    "scripts"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run check && npm run build && npm test"
  },
  "dependencies": {
    "@lenticule-science/articulating": "0.4.2",
    "@red-cup-engineering/semantic-record-journal-service": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
