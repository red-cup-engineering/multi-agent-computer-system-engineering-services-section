{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feltos-enterprise-host/enterprise-actor-service",
  "title": "Callable office service offering",
  "type": "object",
  "required": [
    "id",
    "invocation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "invocation": {
      "type": "object",
      "required": [
        "verb",
        "executor",
        "requesters",
        "input"
      ],
      "properties": {
        "verb": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "operation": {
          "type": "string",
          "pattern": "^ni:"
        },
        "executor": {
          "type": "string",
          "minLength": 1
        },
        "requesters": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "const": "*"
              },
              {
                "type": "string",
                "pattern": "^https?://"
              }
            ]
          }
        },
        "input": {
          "type": [
            "object",
            "boolean"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
