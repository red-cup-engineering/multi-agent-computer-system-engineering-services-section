{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feltos.enterprise-host.v1",
  "title": "FeltOS enterprise host declaration",
  "description": "A host points to one MetroPlat instance declaration and owns the network and companion configuration. The instance itself carries no host process configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "hostKind",
    "instance",
    "web"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "hostKind": {
      "const": "feltos.enterprise-host"
    },
    "instance": {
      "type": "string",
      "minLength": 1,
      "description": "Path to the MetroPlat instance declaration, relative to this host declaration."
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instructions": {
          "type": "string"
        },
        "cookiePrefix": {
          "type": "string"
        },
        "defaultPaths": {
          "type": "object"
        },
        "environmentAliases": {
          "type": "object"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "networkSources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "workPeerHealth": {
          "description": "Optional health contracts for separately admitted work peers. A declaration grants no work authority. The existing catch-up observes only selected, held peers; /healthz is fixed on the actor's HTTPS origin.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor", "kind", "service"],
            "properties": {
              "actor": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+/actors/[a-z0-9][a-z0-9._-]*$",
                "description": "A unique canonical HTTPS instance actor, without credentials, query, or fragment; the loader also checks URL canonical form."
              },
              "kind": { "const": "metroplat-supervised-health" },
              "service": { "type": "string", "pattern": "\\S" }
            }
          }
        },
        "companions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
