{
  "name": "@red-cup-engineering/organizing",
  "version": "0.2.0",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "relational-computing",
    "relational-computing-kernel"
  ],
  "description": "Work coordination, witness-preserving federation, and accounting operations. Shared evidence is retained; assertion and denial of the same value are held together; distinct values and overlapping workspace claims require admission.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && node copy-dist-assets.mjs && chmod +x dist/scripts/*.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "rebuild": "npm run clean && npm run build",
    "examples": "node examples/organize.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "organize": "./dist/scripts/cli.mjs",
    "organize-serve": "./dist/scripts/serve.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@lenticule-science/articulating": "0.4.2",
    "@lenticule-science/governance-services-section": "0.1.4",
